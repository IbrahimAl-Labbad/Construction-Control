# =============================================================================
# CONSTRUCTION CONTROL — ENVIRONMENT VARIABLES EXAMPLE
# =============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NEVER commit .env or .env.local to version control.
# This .env.example file IS committed — it documents required variables.
#
# All variables are validated at application startup in lib/config/env.ts.
# If a required variable is missing, the application will refuse to start.
# =============================================================================

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Example: postgresql://ccuser:secret@localhost:5432/construction_control
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/construction_control?schema=public"

# =============================================================================
# NEXTAUTH / AUTH.JS
# =============================================================================
# Secret used to encrypt session tokens and CSRF tokens.
# Generate a strong secret with: openssl rand -base64 32
# REQUIRED in production. Can be any random string in development.
NEXTAUTH_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

# The canonical URL of this application.
# In development: http://localhost:3000
# In production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# OBJECT STORAGE (Reserved for future use — v2)
# =============================================================================
# Not required in v1. Placeholder for future file upload features.
# STORAGE_PROVIDER="s3"           # Options: s3, gcs, azure, local
# STORAGE_BUCKET=""               # Bucket/container name
# STORAGE_REGION=""               # AWS region or equivalent
# STORAGE_ACCESS_KEY_ID=""        # Access key
# STORAGE_SECRET_ACCESS_KEY=""    # Secret key
# STORAGE_ENDPOINT_URL=""         # For S3-compatible stores (e.g., MinIO)

# =============================================================================
# APPLICATION
# =============================================================================
# Node environment. Do not change in production.
NODE_ENV="development"

# Application log level: error | warn | info | debug
# In production, use "info" or "warn"
LOG_LEVEL="info"
