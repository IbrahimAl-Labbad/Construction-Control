// =============================================================================
// PRISMA SCHEMA — CONSTRUCTION CONTROL
// =============================================================================
// Rules (from AGENTS.md §11):
// - Use cuid() for IDs
// - Use @db.Timestamptz for all DateTime fields
// - Use Decimal @db.Decimal(15,2) for money fields
// - Never use Float for money
// - Never hard-delete financial records (use deletedAt)
// - Every financial entity must have createdAt + updatedAt
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMERATIONS
// =============================================================================

/// The four roles of the system. Do not add roles without updating AGENTS.md.
enum Role {
  MANAGER
  ENGINEER
  ACCOUNTANT
  PURCHASING
}

/// Project lifecycle status for construction projects.
enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

/// Lifecycle status for project budgets.
enum BudgetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED
}

/// Standard cost categories for budget line items.
enum BudgetCategory {
  MATERIALS
  LABOR
  SUBCONTRACTOR
  EQUIPMENT
  SITE_OPERATIONS
  CONTINGENCY
}

/// Operational and approval lifecycle status for expenses.
enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/// Operational and approval lifecycle status for purchasing commitments.
enum CommitmentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/// Operational and approval lifecycle status for custody cash advances.
enum CustodyStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  ISSUED
  PARTIALLY_SETTLED
  SETTLED
  CLOSED
}

/// Operational and approval lifecycle status for subcontractor billing claims (مستخلصات مقاولي الباطن).
enum SubcontractorBillingStatus {
  DRAFT       // Created by Accountant, editable
  SUBMITTED   // Submitted for Manager approval, locked
  APPROVED    // Certified — strictly immutable
  REJECTED    // Rejected by Manager, can be reopened to DRAFT
  CANCELLED   // Terminal — voided before approval
}

/// Operational and approval lifecycle status for project payroll/labor cost entries (الشريحة الرأسية 8).
enum PayrollStatus {
  DRAFT       // Created by Accountant, editable
  SUBMITTED   // Submitted for Manager approval, locked
  APPROVED    // Approved by Manager — strictly immutable ledger record
  REJECTED    // Rejected by Manager, can be reopened to DRAFT
  CANCELLED   // Terminal — voided before approval
}

/// Operational and approval lifecycle status for Site Engineer progress reports (الشريحة الرأسية 10).
enum ProgressReportStatus {
  DRAFT       // Created by Engineer; editable
  SUBMITTED   // Submitted for Manager review; locked
  APPROVED    // Approved by Manager — strictly immutable
  REJECTED    // Rejected by Manager; Engineer may reopen to DRAFT
  CANCELLED   // Terminal — voided before or after submission
}


// =============================================================================
// IDENTITY & ACCESS MODELS
// These are required by NextAuth.js (Auth.js) with Prisma adapter.
// See: https://authjs.dev/reference/adapter/prisma
// =============================================================================

/// Application user. Managed by Manager only — no public registration.
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime? @db.Timestamptz

  /// Hashed password (bcrypt, min 12 rounds). Stored separately via Credential.
  /// NextAuth uses Credentials provider — password is not stored on User directly.
  /// Kept in the Credential model below.

  /// Profile image URL (optional, future use)
  image String?

  /// The four roles. Each user has exactly one role.
  role Role @default(ENGINEER)

  /// Active status. Inactive users are blocked at session creation.
  /// Only Manager can deactivate users.
  isActive Boolean @default(true)

  /// Soft deletion timestamp
  deletedAt DateTime? @db.Timestamptz

  // Password credential
  credential Credential?

  // NextAuth required relations
  accounts Account[]
  sessions Session[]

  // Projects managed by this user
  managedProjects Project[] @relation("ProjectManager")

  // Budgets created by this user
  createdBudgets Budget[] @relation("BudgetCreator")

  // Budgets approved by this user
  approvedBudgets Budget[] @relation("BudgetApprover")

  // Expenses submitted by this user
  submittedExpenses Expense[] @relation("ExpenseSubmitter")

  // Expenses approved by this user
  approvedExpenses Expense[] @relation("ExpenseApprover")

  // Expenses rejected by this user
  rejectedExpenses Expense[] @relation("ExpenseRejecter")

  // Commitments created by this user
  createdCommitments Commitment[] @relation("CommitmentCreator")

  // Commitments submitted by this user
  submittedCommitments Commitment[] @relation("CommitmentSubmitter")

  // Commitments approved by this user
  approvedCommitments Commitment[] @relation("CommitmentApprover")

  // Commitments rejected by this user
  rejectedCommitments Commitment[] @relation("CommitmentRejecter")

  // Custodies held by this user as custodian
  custodianCustodies Custody[] @relation("CustodianUser")

  // Custodies created by this user
  createdCustodies Custody[] @relation("CustodyCreator")

  // Custodies submitted by this user
  submittedCustodies Custody[] @relation("CustodySubmitter")

  // Custodies approved by this user
  approvedCustodies Custody[] @relation("CustodyApprover")

  // Custodies rejected by this user
  rejectedCustodies Custody[] @relation("CustodyRejecter")

  // Custodies cancelled by this user
  cancelledCustodies Custody[] @relation("CustodyCanceller")

  // Custodies issued by this user
  issuedCustodies Custody[] @relation("CustodyIssuer")

  // Custodies closed by this user
  closedCustodies Custody[] @relation("CustodyCloser")

  // Subcontractor Billings (Vertical Slice 7)
  createdBillings   SubcontractorBilling[] @relation("BillingCreator")
  submittedBillings SubcontractorBilling[] @relation("BillingSubmitter")
  approvedBillings  SubcontractorBilling[] @relation("BillingApprover")
  rejectedBillings  SubcontractorBilling[] @relation("BillingRejecter")

  // Payroll Entries (Vertical Slice 8)
  createdPayrollEntries   PayrollEntry[] @relation("PayrollCreator")
  submittedPayrollEntries PayrollEntry[] @relation("PayrollSubmitter")
  approvedPayrollEntries  PayrollEntry[] @relation("PayrollApprover")
  rejectedPayrollEntries  PayrollEntry[] @relation("PayrollRejecter")
  cancelledPayrollEntries PayrollEntry[] @relation("PayrollCanceller")

  // Progress Reports (Vertical Slice 10)
  createdProgressReports   ProgressReport[] @relation("ReportCreator")
  approvedProgressReports  ProgressReport[] @relation("ReportApprover")
  rejectedProgressReports  ProgressReport[] @relation("ReportRejecter")
  cancelledProgressReports ProgressReport[] @relation("ReportCanceller")


  // Audit trail
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

/// Hashed credential for password-based authentication.
/// Separate from User to allow future OAuth providers without polluting User.
model Credential {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Argon2id hash of the password (never store plaintext)
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  @@map("credentials")
}

/// Append-only audit trail for all sensitive and financial state transitions.
/// Entries must never be modified or deleted.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  /// User ID who performed the action (nullable for unauthenticated actions)
  action     String   /// Event name (e.g. 'AUTH_LOGIN_SUCCESS', 'AUTH_LOGIN_FAILURE', 'USER_DEACTIVATED')
  entityType String   /// Target entity type (e.g. 'USER', 'SESSION')
  entityId   String?  /// Identifier of the target entity
  metadata   Json?    /// Contextual metadata (IP, user-agent, reason, etc.)
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// PROJECT DOMAIN MODELS
// =============================================================================

/// Operational and control layer representation of a construction project.
model Project {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?       @db.Text
  location    String?
  status      ProjectStatus @default(PLANNED)

  /// Assigned project manager (must have Role.MANAGER and isActive = true)
  managerId   String
  manager     User          @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Restrict)

  /// Operational schedule
  startDate   DateTime?     @db.Timestamptz
  endDate     DateTime?     @db.Timestamptz

  /// Budgets for this project
  budgets     Budget[]

  /// Expenses for this project
  expenses    Expense[]

  /// Commitments for this project
  commitments Commitment[]

  /// Custodies for this project
  custodies   Custody[]

  /// Subcontractor Billings for this project (Vertical Slice 7)
  subcontractorBillings SubcontractorBilling[]

  /// Payroll Entries for this project (Vertical Slice 8)
  payrollEntries        PayrollEntry[]

  /// Progress Reports for this project (Vertical Slice 10)
  progressReports       ProgressReport[]


  /// Soft deletion timestamp
  deletedAt   DateTime?     @db.Timestamptz

  /// Audit timestamps
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  @@index([managerId])
  @@index([status])
  @@index([deletedAt])
  @@map("projects")
}

// =============================================================================
// BUDGET DOMAIN MODELS
// =============================================================================

/// Project Budget header representing a specific version of project cost baseline.
model Budget {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)

  version         Int           @default(1)
  status          BudgetStatus  @default(DRAFT)

  /// Total authorized budget calculated server-side from lines. Decimal(15,2) in SAR.
  totalAmount     Decimal       @db.Decimal(15, 2)
  currency        String        @default("SAR")
  notes           String?       @db.Text

  /// Creator & Submitter tracking
  createdById     String
  createdBy       User          @relation("BudgetCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// Approval tracking
  approvedById    String?
  approvedBy      User?         @relation("BudgetApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt      DateTime?     @db.Timestamptz
  rejectionReason String?       @db.Text

  /// Soft deletion timestamp
  deletedAt       DateTime?     @db.Timestamptz

  /// Audit timestamps
  createdAt       DateTime      @default(now()) @db.Timestamptz
  updatedAt       DateTime      @updatedAt @db.Timestamptz

  /// Related line items
  lines           BudgetLine[]

  @@unique([projectId, version])
  @@index([projectId, status])
  @@index([createdById])
  @@index([approvedById])
  @@index([deletedAt])
  @@map("budgets")
}

/// Granular line item under a Project Budget.
/// Mutable only while parent Budget is in DRAFT status.
/// Once Budget is APPROVED, lines are strictly immutable.
model BudgetLine {
  id          String         @id @default(cuid())
  budgetId    String
  budget      Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  category    BudgetCategory
  description String         @db.Text
  amount      Decimal        @db.Decimal(15, 2)

  /// Audit timestamps
  createdAt   DateTime       @default(now()) @db.Timestamptz
  updatedAt   DateTime       @updatedAt @db.Timestamptz

  /// Related expenses charged against this budget line
  expenses    Expense[]

  /// Related commitments charged against this budget line
  commitments Commitment[]

  /// Related custodies charged against this budget line
  custodies   Custody[]

  /// Related subcontractor billings against this budget line (Vertical Slice 7)
  subcontractorBillings SubcontractorBilling[]

  /// Related payroll entries against this budget line (Vertical Slice 8)
  payrollEntries        PayrollEntry[]


  @@index([budgetId])
  @@index([category])
  @@map("budget_lines")
}

// =============================================================================
// EXPENSE DOMAIN MODELS
// =============================================================================

/// Granular operational expense claim linked to a Project Budget Line.
/// Approved records represent realized actual spend and are strictly immutable.
model Expense {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)

  budgetLineId    String
  budgetLine      BudgetLine     @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)

  /// Monetary amount in SAR. Positive Decimal(15,2).
  amount          Decimal        @db.Decimal(15, 2)
  currency        String         @default("SAR")

  /// Operational description of the spend event
  description     String         @db.Text

  /// Date the expense occurred in the field
  expenseDate     DateTime       @db.Timestamptz

  /// Operational status of the claim
  status          ExpenseStatus  @default(DRAFT)

  /// Submitter / Claimant tracking
  submittedById   String
  submittedBy     User           @relation("ExpenseSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt     DateTime?      @db.Timestamptz

  /// Approval tracking
  approvedById    String?
  approvedBy      User?          @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt      DateTime?      @db.Timestamptz

  /// Rejection tracking
  rejectedById    String?
  rejectedBy      User?          @relation("ExpenseRejecter", fields: [rejectedById], references: [id], onDelete: Restrict)
  rejectedAt      DateTime?      @db.Timestamptz
  rejectionReason String?        @db.Text

  /// Related custody advance (if this expense settles a cash advance)
  custodyId       String?
  custody         Custody?       @relation("CustodyExpenses", fields: [custodyId], references: [id], onDelete: Restrict)

  /// Soft deletion timestamp
  deletedAt       DateTime?      @db.Timestamptz

  /// Audit timestamps
  createdAt       DateTime       @default(now()) @db.Timestamptz
  updatedAt       DateTime       @updatedAt @db.Timestamptz

  @@index([projectId, status])
  @@index([budgetLineId, status])
  @@index([custodyId])
  @@index([submittedById])
  @@index([approvedById])
  @@index([rejectedById])
  @@index([expenseDate])
  @@index([deletedAt])
  @@map("expenses")
}

// =============================================================================
// COMMITMENT DOMAIN MODELS
// =============================================================================

/// Granular purchasing or contractual commitment linked to a Project Budget Line.
/// Approved records encumber the BudgetLine ceiling and are strictly immutable.
model Commitment {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)

  budgetLineId    String
  budgetLine      BudgetLine       @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)

  /// Reference number (e.g. Purchase Order or Contract #). Optional.
  referenceNumber String?          @db.VarChar(100)

  /// External vendor or contractor trade name (plain validated text)
  vendorName      String           @db.VarChar(150)

  /// Committed monetary obligation in SAR. Positive Decimal(15,2).
  amount          Decimal          @db.Decimal(15, 2)
  currency        String           @default("SAR")

  /// Operational description of the commitment
  description     String           @db.Text

  /// Official commitment or issuance date
  commitmentDate  DateTime         @db.Timestamptz

  /// Operational status of the commitment
  status          CommitmentStatus @default(DRAFT)

  /// Creator tracking (Purchasing Officer)
  createdById     String
  createdBy       User             @relation("CommitmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// Submitter tracking
  submittedById   String?
  submittedBy     User?            @relation("CommitmentSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt     DateTime?        @db.Timestamptz

  /// Approval tracking (Manager only)
  approvedById    String?
  approvedBy      User?            @relation("CommitmentApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt      DateTime?        @db.Timestamptz

  /// Rejection tracking
  rejectedById    String?
  rejectedBy      User?            @relation("CommitmentRejecter", fields: [rejectedById], references: [id], onDelete: Restrict)
  rejectedAt      DateTime?        @db.Timestamptz
  rejectionReason String?          @db.Text

  /// Soft deletion timestamp
  deletedAt       DateTime?        @db.Timestamptz

  /// Audit timestamps
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz

  /// Subcontractor Billing claims drawn against this commitment (Vertical Slice 7)
  subcontractorBillings SubcontractorBilling[]

  @@index([projectId, status])
  @@index([budgetLineId, status])
  @@index([createdById])
  @@index([submittedById])
  @@index([approvedById])
  @@index([commitmentDate])
  @@index([deletedAt])
  @@map("commitments")
}

// =============================================================================
// CUSTODY / ADVANCE PAYMENT DOMAIN MODELS
// =============================================================================

/// Operational cash advance envelope linked to a Project Budget Line.
/// Approved and issued advances represent entrusted funds subject to reconciliation.
model Custody {
  id                     String        @id @default(cuid())
  code                   String        @unique
  projectId              String
  project                Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)

  budgetLineId           String
  budgetLine             BudgetLine    @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)

  /// Authorized employee accountable for holding physical cash
  custodianUserId        String
  custodian              User          @relation("CustodianUser", fields: [custodianUserId], references: [id], onDelete: Restrict)

  /// Authorized advance monetary amount in SAR. Positive Decimal(15,2).
  amount                 Decimal       @db.Decimal(15, 2)
  currency               String        @default("SAR")

  /// Operational purpose and justification
  purpose                String        @db.Text

  /// Operational and approval lifecycle status
  status                 CustodyStatus @default(DRAFT)

  /// Recorded unspent cash returned to company
  cashReturnedAmount     Decimal       @default(0.00) @db.Decimal(15, 2)

  /// Creator tracking
  createdById            String
  createdBy              User          @relation("CustodyCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// Submitter tracking
  submittedById          String?
  submittedBy            User?         @relation("CustodySubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt            DateTime?     @db.Timestamptz

  /// Approval tracking (Manager only)
  approvedById           String?
  approvedBy             User?         @relation("CustodyApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt             DateTime?     @db.Timestamptz

  /// Rejection tracking
  rejectedById           String?
  rejectedBy             User?         @relation("CustodyRejecter", fields: [rejectedById], references: [id], onDelete: Restrict)
  rejectedAt             DateTime?     @db.Timestamptz
  rejectionReason        String?       @db.Text

  /// Pre-issuance cancellation tracking (Manager only)
  cancelledById          String?
  cancelledBy            User?         @relation("CustodyCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelledAt            DateTime?     @db.Timestamptz
  cancellationReason     String?       @db.Text

  /// Cash issuance tracking (Accountant)
  issuedById             String?
  issuedBy               User?         @relation("CustodyIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  issuedAt               DateTime?     @db.Timestamptz

  /// Full settlement timestamp (when balance reaches 0.00)
  settledAt              DateTime?     @db.Timestamptz

  /// Final administrative closure tracking (Manager)
  closedById             String?
  closedBy               User?         @relation("CustodyCloser", fields: [closedById], references: [id], onDelete: Restrict)
  closedAt               DateTime?     @db.Timestamptz

  /// Operational deadline for reconciliation
  expectedSettlementDate DateTime?     @db.Timestamptz

  /// Soft deletion timestamp
  deletedAt              DateTime?     @db.Timestamptz

  /// Audit timestamps
  createdAt              DateTime      @default(now()) @db.Timestamptz
  updatedAt              DateTime      @updatedAt @db.Timestamptz

  /// Expenses settled against this custody advance
  expenses               Expense[]     @relation("CustodyExpenses")

  @@index([projectId, status])
  @@index([budgetLineId, status])
  @@index([custodianUserId])
  @@index([createdById])
  @@index([submittedById])
  @@index([approvedById])
  @@index([issuedById])
  @@index([status])
  @@index([deletedAt])
  @@map("custodies")
}

// =============================================================================
// SUBCONTRACTOR BILLING DOMAIN MODELS (Vertical Slice 7)
// =============================================================================

/// Periodic subcontractor billing claim (مستخلص مقاول باطن).
/// Represents a subcontractor's certified monetary claim against an approved Commitment.
/// Billing is a certification of progress — NOT a new BudgetLine encumbrance.
/// Approved records are strictly immutable (AGENTS.md §13).
/// Must never be hard-deleted after submission (AGENTS.md §14 — SubcontractorBill).
model SubcontractorBilling {
  id                String                     @id @default(cuid())

  projectId         String
  project           Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)

  budgetLineId      String
  budgetLine        BudgetLine                 @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)

  /// The approved Commitment this billing draws against.
  /// Must be APPROVED, same project, same budgetLine. Required — billing cannot exist without a Commitment.
  commitmentId      String
  commitment        Commitment                 @relation(fields: [commitmentId], references: [id], onDelete: Restrict)

  /// Subcontractor trade name (plain text, v1 — no Subcontractor master entity).
  /// Must match commitment.vendorName (enforced at application layer).
  subcontractorName String                     @db.VarChar(150)

  /// Billing reference number (مستخلص رقم). Optional, nullable.
  /// When present, must be unique per project (partial unique index in migration).
  referenceNumber   String?                    @db.VarChar(100)

  /// Descriptive text for the billing period (e.g. "سبتمبر 2026").
  /// No DB uniqueness constraint — descriptive only.
  billingPeriod     String                     @db.VarChar(100)

  /// Date the subcontractor submitted this claim.
  claimDate         DateTime                   @db.Timestamptz

  /// Gross claim amount before any deductions. Must be positive SAR. Decimal(15,2).
  /// Cumulative approved billing amounts must not exceed commitment.amount.
  grossAmount       Decimal                    @db.Decimal(15, 2)
  currency          String                     @default("SAR")

  /// Description of work scope covered in this billing period.
  description       String                     @db.Text

  /// Operational lifecycle status.
  status            SubcontractorBillingStatus @default(DRAFT)

  /// Creator tracking (Accountant only)
  createdById       String
  createdBy         User                       @relation("BillingCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// Submitter tracking
  submittedById     String?
  submittedBy       User?                      @relation("BillingSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt       DateTime?                  @db.Timestamptz

  /// Approval tracking (Manager only)
  approvedById      String?
  approvedBy        User?                      @relation("BillingApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt        DateTime?                  @db.Timestamptz

  /// Rejection tracking
  rejectedById      String?
  rejectedBy        User?                      @relation("BillingRejecter", fields: [rejectedById], references: [id], onDelete: Restrict)
  rejectedAt        DateTime?                  @db.Timestamptz
  rejectionReason   String?                    @db.Text

  /// Soft deletion timestamp (AGENTS.md §14)
  deletedAt         DateTime?                  @db.Timestamptz

  /// Audit timestamps
  createdAt         DateTime                   @default(now()) @db.Timestamptz
  updatedAt         DateTime                   @updatedAt @db.Timestamptz

  @@index([projectId, status])
  @@index([budgetLineId, status])
  @@index([commitmentId, status])
  @@index([createdById])
  @@index([submittedById])
  @@index([approvedById])
  @@index([claimDate])
  @@index([deletedAt])
  @@map("subcontractor_billings")
}

// =============================================================================
// PAYROLL DOMAIN MODELS (Vertical Slice 8)
// =============================================================================

/// Operational and control layer representation of a project labor cost entry.
/// Captures approved site labor amounts without processing payroll, salaries, or HR contracts.
/// Approved records represent realized actual labor spend and are strictly immutable (AGENTS.md §13).
model PayrollEntry {
  id                 String        @id @default(cuid())

  projectId          String
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)

  budgetLineId       String
  budgetLine         BudgetLine    @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)

  /// Worker identification snapshot (plain validated text — no HR master entity)
  workerName         String        @db.VarChar(100)
  workerReference    String?       @db.VarChar(50)
  tradeOrTitle       String?       @db.VarChar(50)

  /// Calendar period
  periodYear         Int
  periodMonth        Int

  /// Monetary labor cost amount in SAR. Positive Decimal(15, 2).
  amount             Decimal       @db.Decimal(15, 2)
  currency           String        @default("SAR")

  /// Operational description / site notes
  description        String        @db.Text

  /// Operational lifecycle status
  status             PayrollStatus @default(DRAFT)

  /// Creator tracking (Accountant only)
  createdById        String
  createdBy          User          @relation("PayrollCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// Submitter tracking
  submittedById      String?
  submittedBy        User?         @relation("PayrollSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt        DateTime?     @db.Timestamptz

  /// Approval tracking (Manager only)
  approvedById       String?
  approvedBy         User?         @relation("PayrollApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt         DateTime?     @db.Timestamptz

  /// Rejection tracking
  rejectedById       String?
  rejectedBy         User?         @relation("PayrollRejecter", fields: [rejectedById], references: [id], onDelete: Restrict)
  rejectedAt         DateTime?     @db.Timestamptz
  rejectionReason    String?       @db.Text

  /// Cancellation tracking
  cancelledById      String?
  cancelledBy        User?         @relation("PayrollCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelledAt        DateTime?     @db.Timestamptz
  cancellationReason String?       @db.Text

  /// Soft deletion timestamp (AGENTS.md §14)
  deletedAt          DateTime?     @db.Timestamptz

  /// Audit timestamps
  createdAt          DateTime      @default(now()) @db.Timestamptz
  updatedAt          DateTime      @updatedAt @db.Timestamptz

  @@index([projectId, status])
  @@index([budgetLineId, status])
  @@index([periodYear, periodMonth])
  @@index([createdById])
  @@index([approvedById])
  @@index([deletedAt])
  @@map("payroll_entries")
}

// =============================================================================
// PROGRESS REPORT DOMAIN MODELS (Vertical Slice 10)
// =============================================================================

/// Operational progress report submitted by a Site Engineer for a construction project.
/// Contains operational narrative only — no financial data.
/// Authored by Role.ENGINEER. Reviewed (approved/rejected) by Role.MANAGER.
/// Approved reports are strictly immutable (AGENTS.md §13 principle).
///
/// deletedAt is present for schema consistency.
/// NO Slice 10 use case sets deletedAt.
/// All operational queries must filter: WHERE deletedAt IS NULL.
/// Admin/cleanup deletion is outside Slice 10 scope.
model ProgressReport {
  id          String               @id @default(cuid())

  /// FK to the project this report covers (must be ACTIVE, not deleted).
  /// Permissive authoring (BD-03 Model C): any active Engineer may target any ACTIVE project.
  projectId   String
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)

  /// Calendar date this report describes. NOT the submission timestamp.
  /// @db.Date — date only; no time component; no timezone stored.
  /// DTO representation: YYYY-MM-DD string.
  /// Cannot be more than 1 day in the future (BD-05b: server-side 1-day tolerance).
  /// Business uniqueness: one report per (projectId, reportDate, createdById).
  reportDate  DateTime             @db.Date

  /// Brief Arabic title for the report (≤ 150 chars).
  title       String               @db.VarChar(150)

  /// Narrative description of completed work during the report period (≤ 3000 chars).
  /// Free text. UI instructs Engineers not to include worker names, phone numbers, or financial data.
  workDescription String           @db.Text

  /// Optional self-reported overall project completion estimate (0–100, integer).
  /// Qualitative operational signal only. Not derived from financial data.
  progressPercentage Int?

  /// Optional: operational blockers, risks, or notable site conditions (≤ 1500 chars).
  blockers    String?              @db.Text

  /// Optional: planned work for the next reporting period (≤ 1500 chars).
  nextPeriodPlan String?           @db.Text

  /// Optional: weather conditions at site, free text (≤ 100 chars).
  weatherCondition String?         @db.VarChar(100)

  /// Operational lifecycle status.
  status      ProgressReportStatus @default(DRAFT)

  /// Engineer who authored this report. Immutable after creation.
  createdById String
  createdBy   User                 @relation("ReportCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// Timestamp when the Engineer submitted this report for Manager review.
  /// Written on DRAFT → SUBMITTED transition.
  /// No submittedBy FK: the submitter is always the creator (createdById).
  submittedAt DateTime?            @db.Timestamptz

  /// Approval tracking — Manager who approved and when.
  /// Written on SUBMITTED → APPROVED transition. Immutable once set.
  approvedById String?
  approvedBy   User?               @relation("ReportApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt   DateTime?           @db.Timestamptz

  /// Rejection tracking — Manager who rejected, when, and the reason.
  /// Written on SUBMITTED → REJECTED transition.
  /// Cleared (set to null) on REJECTED → DRAFT (reopen) transition.
  rejectedById    String?
  rejectedBy      User?            @relation("ReportRejecter", fields: [rejectedById], references: [id], onDelete: Restrict)
  rejectedAt      DateTime?        @db.Timestamptz
  rejectionReason String?          @db.Text

  /// Cancellation tracking — who cancelled, when, and the reason.
  /// Written on DRAFT → CANCELLED or SUBMITTED → CANCELLED transition (terminal).
  cancelledById      String?
  cancelledBy        User?         @relation("ReportCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelledAt        DateTime?     @db.Timestamptz
  cancellationReason String?       @db.Text

  /// Soft deletion marker — present for schema consistency.
  /// NO Slice 10 use case sets this field.
  deletedAt   DateTime?            @db.Timestamptz

  /// Audit timestamps — DB-managed.
  createdAt   DateTime             @default(now()) @db.Timestamptz
  updatedAt   DateTime             @updatedAt @db.Timestamptz

  /// Business uniqueness: one report per Engineer per project per calendar date.
  /// CANCELLED reports are NOT exempt from this constraint.
  /// A cancelled report permanently occupies the (projectId, reportDate, createdById) slot.
  /// The same Engineer cannot create a replacement report for the same date after cancellation.
  @@unique([projectId, reportDate, createdById])

  @@index([projectId, status])
  @@index([createdById, status])
  @@index([reportDate])
  @@index([deletedAt])
  @@map("progress_reports")
}


// NextAuth.js adapter required models below.
// See: https://authjs.dev/reference/adapter/prisma

/// OAuth account (reserved for future providers; currently unused in v1).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Database session for NextAuth.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([userId])
  @@map("sessions")
}

/// Email verification token (NextAuth email provider — reserved for future use).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
  @@map("verification_tokens")
}
