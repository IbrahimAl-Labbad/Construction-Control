// =============================================================================
// PRISMA SCHEMA — CONSTRUCTION CONTROL
// =============================================================================
// Rules (from AGENTS.md §11):
// - Use cuid() for IDs
// - Use @db.Timestamptz for all DateTime fields
// - Use Decimal @db.Decimal(15,2) for money fields
// - Never use Float for money
// - Never hard-delete financial records (use deletedAt)
// - Every financial entity must have createdAt + updatedAt
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMERATIONS
// =============================================================================

/// The four roles of the system. Do not add roles without updating AGENTS.md.
enum Role {
  MANAGER
  ENGINEER
  ACCOUNTANT
  PURCHASING
}

/// Project lifecycle status for construction projects.
enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

/// Lifecycle status for project budgets.
enum BudgetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED
}

/// Standard cost categories for budget line items.
enum BudgetCategory {
  MATERIALS
  LABOR
  SUBCONTRACTOR
  EQUIPMENT
  SITE_OPERATIONS
  CONTINGENCY
}

/// Operational and approval lifecycle status for expenses.
enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/// Operational and approval lifecycle status for purchasing commitments.
enum CommitmentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/// Operational and approval lifecycle status for custody cash advances.
enum CustodyStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  ISSUED
  PARTIALLY_SETTLED
  SETTLED
  CLOSED
}

// =============================================================================
// IDENTITY & ACCESS MODELS
// These are required by NextAuth.js (Auth.js) with Prisma adapter.
// See: https://authjs.dev/reference/adapter/prisma
// =============================================================================

/// Application user. Managed by Manager only — no public registration.
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime? @db.Timestamptz

  /// Hashed password (bcrypt, min 12 rounds). Stored separately via Credential.
  /// NextAuth uses Credentials provider — password is not stored on User directly.
  /// Kept in the Credential model below.

  /// Profile image URL (optional, future use)
  image String?

  /// The four roles. Each user has exactly one role.
  role Role @default(ENGINEER)

  /// Active status. Inactive users are blocked at session creation.
  /// Only Manager can deactivate users.
  isActive Boolean @default(true)

  /// Soft deletion timestamp
  deletedAt DateTime? @db.Timestamptz

  // Password credential
  credential Credential?

  // NextAuth required relations
  accounts Account[]
  sessions Session[]

  // Projects managed by this user
  managedProjects Project[] @relation("ProjectManager")

  // Budgets created by this user
  createdBudgets Budget[] @relation("BudgetCreator")

  // Budgets approved by this user
  approvedBudgets Budget[] @relation("BudgetApprover")

  // Expenses submitted by this user
  submittedExpenses Expense[] @relation("ExpenseSubmitter")

  // Expenses approved by this user
  approvedExpenses Expense[] @relation("ExpenseApprover")

  // Expenses rejected by this user
  rejectedExpenses Expense[] @relation("ExpenseRejecter")

  // Commitments created by this user
  createdCommitments Commitment[] @relation("CommitmentCreator")

  // Commitments submitted by this user
  submittedCommitments Commitment[] @relation("CommitmentSubmitter")

  // Commitments approved by this user
  approvedCommitments Commitment[] @relation("CommitmentApprover")

  // Commitments rejected by this user
  rejectedCommitments Commitment[] @relation("CommitmentRejecter")

  // Custodies held by this user as custodian
  custodianCustodies Custody[] @relation("CustodianUser")

  // Custodies created by this user
  createdCustodies Custody[] @relation("CustodyCreator")

  // Custodies submitted by this user
  submittedCustodies Custody[] @relation("CustodySubmitter")

  // Custodies approved by this user
  approvedCustodies Custody[] @relation("CustodyApprover")

  // Custodies rejected by this user
  rejectedCustodies Custody[] @relation("CustodyRejecter")

  // Custodies cancelled by this user
  cancelledCustodies Custody[] @relation("CustodyCanceller")

  // Custodies issued by this user
  issuedCustodies Custody[] @relation("CustodyIssuer")

  // Custodies closed by this user
  closedCustodies Custody[] @relation("CustodyCloser")

  // Audit trail
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

/// Hashed credential for password-based authentication.
/// Separate from User to allow future OAuth providers without polluting User.
model Credential {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Argon2id hash of the password (never store plaintext)
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  @@map("credentials")
}

/// Append-only audit trail for all sensitive and financial state transitions.
/// Entries must never be modified or deleted.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  /// User ID who performed the action (nullable for unauthenticated actions)
  action     String   /// Event name (e.g. 'AUTH_LOGIN_SUCCESS', 'AUTH_LOGIN_FAILURE', 'USER_DEACTIVATED')
  entityType String   /// Target entity type (e.g. 'USER', 'SESSION')
  entityId   String?  /// Identifier of the target entity
  metadata   Json?    /// Contextual metadata (IP, user-agent, reason, etc.)
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// PROJECT DOMAIN MODELS
// =============================================================================

/// Operational and control layer representation of a construction project.
model Project {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?       @db.Text
  location    String?
  status      ProjectStatus @default(PLANNED)

  /// Assigned project manager (must have Role.MANAGER and isActive = true)
  managerId   String
  manager     User          @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Restrict)

  /// Operational schedule
  startDate   DateTime?     @db.Timestamptz
  endDate     DateTime?     @db.Timestamptz

  /// Budgets for this project
  budgets     Budget[]

  /// Expenses for this project
  expenses    Expense[]

  /// Commitments for this project
  commitments Commitment[]

  /// Custodies for this project
  custodies   Custody[]

  /// Soft deletion timestamp
  deletedAt   DateTime?     @db.Timestamptz

  /// Audit timestamps
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  @@index([managerId])
  @@index([status])
  @@index([deletedAt])
  @@map("projects")
}

// =============================================================================
// BUDGET DOMAIN MODELS
// =============================================================================

/// Project Budget header representing a specific version of project cost baseline.
model Budget {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)

  version         Int           @default(1)
  status          BudgetStatus  @default(DRAFT)

  /// Total authorized budget calculated server-side from lines. Decimal(15,2) in SAR.
  totalAmount     Decimal       @db.Decimal(15, 2)
  currency        String        @default("SAR")
  notes           String?       @db.Text

  /// Creator & Submitter tracking
  createdById     String
  createdBy       User          @relation("BudgetCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// Approval tracking
  approvedById    String?
  approvedBy      User?         @relation("BudgetApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt      DateTime?     @db.Timestamptz
  rejectionReason String?       @db.Text

  /// Soft deletion timestamp
  deletedAt       DateTime?     @db.Timestamptz

  /// Audit timestamps
  createdAt       DateTime      @default(now()) @db.Timestamptz
  updatedAt       DateTime      @updatedAt @db.Timestamptz

  /// Related line items
  lines           BudgetLine[]

  @@unique([projectId, version])
  @@index([projectId, status])
  @@index([createdById])
  @@index([approvedById])
  @@index([deletedAt])
  @@map("budgets")
}

/// Granular line item under a Project Budget.
/// Mutable only while parent Budget is in DRAFT status.
/// Once Budget is APPROVED, lines are strictly immutable.
model BudgetLine {
  id          String         @id @default(cuid())
  budgetId    String
  budget      Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  category    BudgetCategory
  description String         @db.Text
  amount      Decimal        @db.Decimal(15, 2)

  /// Audit timestamps
  createdAt   DateTime       @default(now()) @db.Timestamptz
  updatedAt   DateTime       @updatedAt @db.Timestamptz

  /// Related expenses charged against this budget line
  expenses    Expense[]

  /// Related commitments charged against this budget line
  commitments Commitment[]

  /// Related custodies charged against this budget line
  custodies   Custody[]

  @@index([budgetId])
  @@index([category])
  @@map("budget_lines")
}

// =============================================================================
// EXPENSE DOMAIN MODELS
// =============================================================================

/// Granular operational expense claim linked to a Project Budget Line.
/// Approved records represent realized actual spend and are strictly immutable.
model Expense {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)

  budgetLineId    String
  budgetLine      BudgetLine     @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)

  /// Monetary amount in SAR. Positive Decimal(15,2).
  amount          Decimal        @db.Decimal(15, 2)
  currency        String         @default("SAR")

  /// Operational description of the spend event
  description     String         @db.Text

  /// Date the expense occurred in the field
  expenseDate     DateTime       @db.Timestamptz

  /// Operational status of the claim
  status          ExpenseStatus  @default(DRAFT)

  /// Submitter / Claimant tracking
  submittedById   String
  submittedBy     User           @relation("ExpenseSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt     DateTime?      @db.Timestamptz

  /// Approval tracking
  approvedById    String?
  approvedBy      User?          @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt      DateTime?      @db.Timestamptz

  /// Rejection tracking
  rejectedById    String?
  rejectedBy      User?          @relation("ExpenseRejecter", fields: [rejectedById], references: [id], onDelete: Restrict)
  rejectedAt      DateTime?      @db.Timestamptz
  rejectionReason String?        @db.Text

  /// Related custody advance (if this expense settles a cash advance)
  custodyId       String?
  custody         Custody?       @relation("CustodyExpenses", fields: [custodyId], references: [id], onDelete: Restrict)

  /// Soft deletion timestamp
  deletedAt       DateTime?      @db.Timestamptz

  /// Audit timestamps
  createdAt       DateTime       @default(now()) @db.Timestamptz
  updatedAt       DateTime       @updatedAt @db.Timestamptz

  @@index([projectId, status])
  @@index([budgetLineId, status])
  @@index([custodyId])
  @@index([submittedById])
  @@index([approvedById])
  @@index([rejectedById])
  @@index([expenseDate])
  @@index([deletedAt])
  @@map("expenses")
}

// =============================================================================
// COMMITMENT DOMAIN MODELS
// =============================================================================

/// Granular purchasing or contractual commitment linked to a Project Budget Line.
/// Approved records encumber the BudgetLine ceiling and are strictly immutable.
model Commitment {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)

  budgetLineId    String
  budgetLine      BudgetLine       @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)

  /// Reference number (e.g. Purchase Order or Contract #). Optional.
  referenceNumber String?          @db.VarChar(100)

  /// External vendor or contractor trade name (plain validated text)
  vendorName      String           @db.VarChar(150)

  /// Committed monetary obligation in SAR. Positive Decimal(15,2).
  amount          Decimal          @db.Decimal(15, 2)
  currency        String           @default("SAR")

  /// Operational description of the commitment
  description     String           @db.Text

  /// Official commitment or issuance date
  commitmentDate  DateTime         @db.Timestamptz

  /// Operational status of the commitment
  status          CommitmentStatus @default(DRAFT)

  /// Creator tracking (Purchasing Officer)
  createdById     String
  createdBy       User             @relation("CommitmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// Submitter tracking
  submittedById   String?
  submittedBy     User?            @relation("CommitmentSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt     DateTime?        @db.Timestamptz

  /// Approval tracking (Manager only)
  approvedById    String?
  approvedBy      User?            @relation("CommitmentApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt      DateTime?        @db.Timestamptz

  /// Rejection tracking
  rejectedById    String?
  rejectedBy      User?            @relation("CommitmentRejecter", fields: [rejectedById], references: [id], onDelete: Restrict)
  rejectedAt      DateTime?        @db.Timestamptz
  rejectionReason String?          @db.Text

  /// Soft deletion timestamp
  deletedAt       DateTime?        @db.Timestamptz

  /// Audit timestamps
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz

  @@index([projectId, status])
  @@index([budgetLineId, status])
  @@index([createdById])
  @@index([submittedById])
  @@index([approvedById])
  @@index([commitmentDate])
  @@index([deletedAt])
  @@map("commitments")
}

// =============================================================================
// CUSTODY / ADVANCE PAYMENT DOMAIN MODELS
// =============================================================================

/// Operational cash advance envelope linked to a Project Budget Line.
/// Approved and issued advances represent entrusted funds subject to reconciliation.
model Custody {
  id                     String        @id @default(cuid())
  code                   String        @unique
  projectId              String
  project                Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)

  budgetLineId           String
  budgetLine             BudgetLine    @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)

  /// Authorized employee accountable for holding physical cash
  custodianUserId        String
  custodian              User          @relation("CustodianUser", fields: [custodianUserId], references: [id], onDelete: Restrict)

  /// Authorized advance monetary amount in SAR. Positive Decimal(15,2).
  amount                 Decimal       @db.Decimal(15, 2)
  currency               String        @default("SAR")

  /// Operational purpose and justification
  purpose                String        @db.Text

  /// Operational and approval lifecycle status
  status                 CustodyStatus @default(DRAFT)

  /// Recorded unspent cash returned to company
  cashReturnedAmount     Decimal       @default(0.00) @db.Decimal(15, 2)

  /// Creator tracking
  createdById            String
  createdBy              User          @relation("CustodyCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// Submitter tracking
  submittedById          String?
  submittedBy            User?         @relation("CustodySubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt            DateTime?     @db.Timestamptz

  /// Approval tracking (Manager only)
  approvedById           String?
  approvedBy             User?         @relation("CustodyApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt             DateTime?     @db.Timestamptz

  /// Rejection tracking
  rejectedById           String?
  rejectedBy             User?         @relation("CustodyRejecter", fields: [rejectedById], references: [id], onDelete: Restrict)
  rejectedAt             DateTime?     @db.Timestamptz
  rejectionReason        String?       @db.Text

  /// Pre-issuance cancellation tracking (Manager only)
  cancelledById          String?
  cancelledBy            User?         @relation("CustodyCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelledAt            DateTime?     @db.Timestamptz
  cancellationReason     String?       @db.Text

  /// Cash issuance tracking (Accountant)
  issuedById             String?
  issuedBy               User?         @relation("CustodyIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  issuedAt               DateTime?     @db.Timestamptz

  /// Full settlement timestamp (when balance reaches 0.00)
  settledAt              DateTime?     @db.Timestamptz

  /// Final administrative closure tracking (Manager)
  closedById             String?
  closedBy               User?         @relation("CustodyCloser", fields: [closedById], references: [id], onDelete: Restrict)
  closedAt               DateTime?     @db.Timestamptz

  /// Operational deadline for reconciliation
  expectedSettlementDate DateTime?     @db.Timestamptz

  /// Soft deletion timestamp
  deletedAt              DateTime?     @db.Timestamptz

  /// Audit timestamps
  createdAt              DateTime      @default(now()) @db.Timestamptz
  updatedAt              DateTime      @updatedAt @db.Timestamptz

  /// Expenses settled against this custody advance
  expenses               Expense[]     @relation("CustodyExpenses")

  @@index([projectId, status])
  @@index([budgetLineId, status])
  @@index([custodianUserId])
  @@index([createdById])
  @@index([submittedById])
  @@index([approvedById])
  @@index([issuedById])
  @@index([status])
  @@index([deletedAt])
  @@map("custodies")
}

// NextAuth.js adapter required models below.
// See: https://authjs.dev/reference/adapter/prisma

/// OAuth account (reserved for future providers; currently unused in v1).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Database session for NextAuth.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([userId])
  @@map("sessions")
}

/// Email verification token (NextAuth email provider — reserved for future use).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
  @@map("verification_tokens")
}
